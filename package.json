{
  "name": "financeiro_pessoal",
  "version": "1.0.0",
  "description": "",
  "main": "dist/desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "bundle:desktop": "esbuild src/desktop/main.ts --bundle --platform=node --target=node22 --outfile=dist/desktop/main.cjs --format=cjs --external:electron --external:better-sqlite3 && esbuild src/desktop/preload.ts --bundle --platform=node --target=node22 --outfile=dist/desktop/preload.cjs --format=cjs --external:electron",
    "build:web": "vite build",
    "build": "npm run build:web && npm run bundle:desktop",
    "start": "electron .",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run bundle:desktop && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  }
}
